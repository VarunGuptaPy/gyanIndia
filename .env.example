# ─── Database ────────────────────────────────────────────────
# Local: `docker compose up -d` starts PostgreSQL on port 5433.
DATABASE_URL="postgresql://gyan:gyan_dev_password@localhost:5433/gyan"
# Optional: separate database used by `npm test` (never point this at real data).
TEST_DATABASE_URL="postgresql://gyan:gyan_dev_password@localhost:5433/gyan_test"

# ─── Site & authentication ───────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"     # production: https://www.gyanindia.com
NEXTAUTH_URL="http://localhost:3000"             # production: https://www.gyanindia.com
NEXTAUTH_SECRET=""                               # generate: openssl rand -base64 32

# ─── Razorpay (leave empty until merchant onboarding is approved) ─
RAZORPAY_KEY_ID=""            # rzp_test_… for test mode
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""    # set the same value in Razorpay Dashboard → Webhooks
# Live keys (rzp_live_…) are refused unless this is "true". Set only after legal/finance sign-off.
PAYMENTS_LIVE_APPROVED="false"

# ─── Email (Resend) — optional; without it emails are skipped, never faked ─
RESEND_API_KEY=""
EMAIL_FROM=""                 # e.g. "GYAN <noreply@gyanindia.com>" (domain must be verified in Resend)

# ─── Development seed only (ignored when NODE_ENV=production) ─
DEV_ADMIN_EMAIL="admin@gyan.local"
DEV_ADMIN_PASSWORD=""         # if empty, the seed uses the documented local default
